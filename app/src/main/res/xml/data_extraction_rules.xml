<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for Android 12+ (API 31+).
   Riplox TT: history and small settings may be backed up, BUT TikTok login cookies
   (the session token) go into neither a cloud backup nor a device transfer.
   The temp cache of an in-flight download is excluded from both as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="external" path="temp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="external" path="temp" />
    </device-transfer>
</data-extraction-rules>
