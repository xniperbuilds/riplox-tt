<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and below (before API 31).
   Riplox TT: download history and small settings may be backed up, BUT TikTok login
   cookies (the session token) must NEVER leave the device in a cloud backup
   (privacy/security). The temp cache of an in-flight download is excluded too.
-->
<full-backup-content>
    <exclude domain="file" path="cookies.txt" />
    <exclude domain="external" path="temp" />
</full-backup-content>
