<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.XniperDownloader" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Transparent theme for the Quick Download popup (the source app stays visible behind it) -->
