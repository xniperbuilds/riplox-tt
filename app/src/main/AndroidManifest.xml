<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Download ke doran WifiLock — screen-off pe Wi-Fi sone se download atakti thi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- BgGuard Step-1: battery-exemption dialog (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS)
         is permission ke BINA silently no-op hota hai — dialog khulta hi nahi (TECNO CLA5
         pe pakda 2026-07-17). Downloads user-initiated hain = Play acceptable use. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 8/9 (API<29) gallery-save ke liye — 10+ pe MediaStore, permission ki zaroorat nahi -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".XniperApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XniperDownloader">

        <!-- AdMob App ID (real — AdMob console). Ye + Ads.kt ki 2 ad-unit IDs. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8029174313177489~6045986402" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XniperDownloader"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickDownloadActivity"
            android:exported="true"
            android:label="@string/quick_label"
            android:theme="@style/Theme.XniperDownloader.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Fail-notif ka "Copy link" action -->
        <receiver
            android:name=".CopyLinkReceiver"
            android:exported="false" />

        <!-- AIRLOCK v3 Escort — chhota FGS jo naye download ko uske apne FGS-lock tak
             protect karta hai (door band hone ke baad ka gap cover) -->
        <service
            android:name=".EscortService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- WorkManager ka foreground-service type ensure (Android 14+ zaroori) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
